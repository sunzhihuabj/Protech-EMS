# =====================================================================
# ProjLife 生产环境变量模板（复制为 .env 并注入；敏感项不入仓不入库）
# 对应 docs/DEPLOYMENT.md §二 凭据清单
# =====================================================================

# ---- 数据库（GreatDB 8.0 兼容 / MySQL 8） ----
DB_HOST=
DB_PORT=3306
DB_NAME=projlife
DB_USERNAME=projlife_app
DB_PASSWORD=

# ---- Redis（会话/权限缓存/黑名单） ----
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- 安全 ----
JWT_SECRET=
SERVER_PORT=8080

# ---- AI 网关（真实模型接入点：配置即生效，代码无改动） ----
PROJLIFE_AI_GATEWAY=http://ai-gateway:8090
PROJLIFE_AI_MODEL_ENDPOINT=          # 内网模型服务地址（OpenAI 兼容口径）
PROJLIFE_AI_MODEL_KEY=               # 模型访问密钥（仅内网，禁公网 BR-AI-02）

# ---- 钉钉（主通道 D-08） ----
DINGTALK_ENABLED=false
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_WEBHOOK=

# ---- 企微（备用通道） ----
WECHAT_ENABLED=false

# ---- 定时任务进程（projlife-job） ----
JOB_ENABLED=false
JOB_GATEWAY=http://app:8080
JOB_SYSTEM_USERNAME=admin@demo
JOB_SYSTEM_PASSWORD=
