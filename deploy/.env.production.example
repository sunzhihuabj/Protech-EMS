# =====================================================================
# ProjLife 生产环境变量模板（复制为 .env 并注入；敏感项不入仓不入库）
# 对应 docs/DEPLOYMENT.md §二 凭据清单
# =====================================================================

# ---- 数据库（GreatDB 8.0 兼容 / MySQL 8） ----
DB_HOST=
DB_PORT=3306
DB_NAME=projlife
DB_USERNAME=projlife_app
DB_PASSWORD=

# ---- Redis（会话/权限缓存/黑名单） ----
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- 安全 ----
JWT_SECRET=
SERVER_PORT=8080

# ---- AI 网关（真实模型接入点：配置即生效，代码无改动） ----
PROJLIFE_AI_GATEWAY=http://ai-gateway:8090
PROJLIFE_AI_MODEL_ENDPOINT=          # 模型服务地址（OpenAI 兼容 chat/completions 全 URL）
PROJLIFE_AI_API_KEY=                 # 模型访问密钥（Bearer；生产轮换，仅内网分发）
PROJLIFE_AI_MODEL_NAME=              # 推理模型名（如 deepseek-ai/deepseek-v4.1-flash）

# ---- 钉钉（主通道 D-08，SPRINT-INT1） ----
PROJLIFE_DINGTALK_ENABLED=false
PROJLIFE_DINGTALK_APP_KEY=
PROJLIFE_DINGTALK_APP_SECRET=
PROJLIFE_DINGTALK_AGENT_ID=
PROJLIFE_DINGTALK_WEBHOOK=
PROJLIFE_DINGTALK_WEBHOOK_SECRET=
PROJLIFE_DINGTALK_USER_MAPPING=

# ---- 售后宝（事件/工单同步，SPRINT-INT1；需固定公网 IP 白名单） ----
PROJLIFE_SHB_ENABLED=false
PROJLIFE_SHB_APP_KEY=
PROJLIFE_SHB_APP_SECRET=
PROJLIFE_SHB_BASE_URL=https://oapi.shb.ltd
PROJLIFE_SHB_WEBHOOK_KEY=

# ---- 捷信通T+（通道B直连，SPRINT-INT1；13.0 红线见 docs/SPRINT-INT1.md） ----
PROJLIFE_TPLUS_ENABLED=false
PROJLIFE_TPLUS_BASE_URL=https://hbtgl.a4.cjtmsp.com
PROJLIFE_TPLUS_APP_KEY=
PROJLIFE_TPLUS_APP_SECRET=
PROJLIFE_TPLUS_ORG_ID=
PROJLIFE_TPLUS_TOKEN_MODE=REALNAME
PROJLIFE_TPLUS_USER_NAME=
PROJLIFE_TPLUS_PASSWORD=
PROJLIFE_TPLUS_ACC_NUM=
PROJLIFE_TPLUS_PRIVATE_KEY=

# ---- 企微（备用通道） ----
WECHAT_ENABLED=false

# ---- 定时任务进程（projlife-job） ----
JOB_ENABLED=false
JOB_GATEWAY=http://app:8080
JOB_SYSTEM_USERNAME=admin@demo
JOB_SYSTEM_PASSWORD=
