<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.projlife</groupId>
        <artifactId>projlife</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>projlife-api</artifactId>
    <name>ProjLife 主应用</name>
    <description>模块化单体主进程：聚合全部业务模块</description>

    <dependencies>
        <dependency>
            <groupId>com.projlife</groupId>
            <artifactId>projlife-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.projlife</groupId>
            <artifactId>projlife-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.projlife</groupId>
            <artifactId>module-org</artifactId>
        </dependency>
        <dependency>
            <groupId>com.projlife</groupId>
            <artifactId>module-file</artifactId>
        </dependency>
        <dependency>
            <groupId>com.projlife</groupId>
            <artifactId>module-integration</artifactId>
        </dependency>
        <dependency>
            <groupId>com.projlife</groupId>
            <artifactId>module-mdm</artifactId>
        </dependency>
        <dependency>
            <groupId>com.projlife</groupId>
            <artifactId>module-project</artifactId>
        </dependency>
        <dependency>
            <groupId>com.projlife</groupId>
            <artifactId>module-plm</artifactId>
        </dependency>
        <dependency>
            <groupId>com.projlife</groupId>
            <artifactId>module-scm</artifactId>
        </dependency>
        <dependency>
            <groupId>com.projlife</groupId>
            <artifactId>module-inventory</artifactId>
        </dependency>
        <dependency>
            <groupId>com.projlife</groupId>
            <artifactId>module-mes</artifactId>
        </dependency>
        <dependency>
            <groupId>com.projlife</groupId>
            <artifactId>module-crm</artifactId>
        </dependency>
        <dependency>
            <groupId>com.projlife</groupId>
            <artifactId>module-contract</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-ui</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>projlife-app</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- 仓库根目录 db/ 为迁移脚本唯一事实源，打包进 jar 供 Flyway 读取 -->
            <resource>
                <directory>${project.basedir}/../db</directory>
                <targetPath>db</targetPath>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
