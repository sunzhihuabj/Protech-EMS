# =====================================================================
# ProjLife/Protech 生产环境配置模板（V4-01 §9 里程碑口径）
# 用法：复制为 application-prod.yml 并按环境注入；敏感项一律走环境变量，不入库不入仓。
# =====================================================================

server:
  port: ${SERVER_PORT:8080}
  # 生产经 Nginx/网关终结 TLS，应用侧保持 HTTP 内网端口（V4-01 §6 部署视图）

spring:
  datasource:
    url: jdbc:mysql://${DB_HOST}:${DB_PORT:3306}/${DB_NAME:projlife}?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=true&requireSSL=true
    username: ${DB_USERNAME}
    password: ${DB_PASSWORD}
    hikari:
      maximum-pool-size: 20
      connection-timeout: 5000
  flyway:
    # 生产 GreatDB(8.0 兼容) 走 Flyway 门禁（ADR-002）；版本表 baseline 前置
    enabled: true
    locations: classpath:db/migration
    baseline-on-migrate: true

  redis:
    host: ${REDIS_HOST}
    port: ${REDIS_PORT:6379}
    password: ${REDIS_PASSWORD:}

projlife:
  security:
    jwt-secret: ${JWT_SECRET}          # ≥32 字符随机串，定期轮换
  notify:
    dingtalk:
      enabled: ${DINGTALK_ENABLED:false}   # 钉钉主通道（D-08），凭据就绪后置 true
      app-key: ${DINGTALK_APP_KEY:}
      webhook: ${DINGTALK_WEBHOOK:}
    wechat:
      enabled: ${WECHAT_ENABLED:false}     # 企微备用通道
  job:
    enabled: ${JOB_ENABLED:false}          # job 进程侧同键控制

ai:
  gateway:
    base-url: ${PROJLIFE_AI_GATEWAY:http://ai-gateway:8090}

logging:
  file:
    name: /var/log/projlife/app.log
  level:
    com.projlife: info
