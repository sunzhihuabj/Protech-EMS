// Protech 企业综合管理系统 · 数据模型（05 册唯一事实源）
// 全局规范（05 册 §一）：id BIGINT 自增；业务编码独立唯一索引；五审计字段全表必备；
// 金额 amount_cents BIGINT（BR-10）；数量 DECIMAL(14,3)；比例 DECIMAL(6,4)；
// timestamptz；枚举存 code（String 列 + shared-types 校验）；库级不建外键约束（应用层保证）。
// BR-11：全表 deleted_at 软删除，无物理删除接口（Prisma middleware 强制）。
// 注意：本文件为 PostgreSQL 交付事实源；本机开发/测试用 scripts/sync-sqlite-schema.mjs
// 生成的 schema.sqlite.prisma 镜像（差异仅 provider 与 @db.* 原生类型标注）。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================ 商务域（T-13 及关联；M02 报价标注新增 Q-10） ============================

/// T-13 合同档案（25 要素四组；两卡点：BR-01 评审带码 / BR-02 用印 3 工作日建档冻结开票）
model Contract {
  id                  BigInt    @id @default(autoincrement())
  contractCode        String    @unique // {主体码}-{YYYY}-{XS/CG/KJ}-{业务码}-{NNNN}；补充协议 -BCn
  contractName        String
  nature              String // E-06 XS/CG/KJ
  bizType             String // 业务码（SB 设备/GC 工程/WX 维保…）
  ourEntityId         BigInt
  counterpartyId      BigInt // 对方主体（T-02，BR-08 下拉）
  amountCents         BigInt // BR-10
  taxRate             String? // DECIMAL(5,4) 文本，如 0.0900
  currency            String    @default("CNY")
  paymentTerms        String?   @db.Text
  settlement          String?   @db.Text
  invoiceReq          String?   @db.Text
  contact             String?
  phone               String?
  deliveryAddr        String?
  signedAt            DateTime? @db.Timestamptz(6)
  effectiveAt         DateTime? @db.Timestamptz(6)
  periodStart         DateTime? @db.Timestamptz(6)
  periodEnd           DateTime? @db.Timestamptz(6)
  warrantyMonths      Int?
  warrantyDepositRate String?
  docCopies           Int?
  filePath            String?
  archiveNo           String?
  status              String    @default("drafting") // E-05 九态
  reviewStatus        String    @default("none") // none / reviewing / approved / rejected
  sealAt              DateTime? @db.Timestamptz(6) // 用印时间（BR-02 起算源）
  sealCopies          Int?
  filedAt             DateTime? @db.Timestamptz(6) // 25 要素建档完成时间
  filedBy             BigInt?
  archiveDeadlineAt   DateTime? @db.Timestamptz(6) // 用印+3 工作日（BR-02 判定源）
  invoicingLocked     Boolean   @default(false) // BR-02 冻结开票
  quotationId         BigInt? // 来源报价（FR-M02-005 中标转化）
  parentContractId    BigInt? // 补充协议主合同
  bcSeq               Int? // -BC{n} 序号
  remark              String?
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  createdBy           BigInt?
  updatedBy           BigInt?
  deletedAt           DateTime? @db.Timestamptz(6)

  @@index([status])
  @@index([counterpartyId])
  @@map("contract")
}

/// 合同-项目关联（FR-M03-003 一合同挂多项目；BR-01 前提 ≥1）
model ContractProject {
  id         BigInt   @id @default(autoincrement())
  contractId BigInt
  projectId  BigInt
  orderLine  String? // 订单行→项目拆挂说明
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  createdBy  BigInt?

  @@unique([contractId, projectId])
  @@index([projectId])
  @@map("contract_project")
}

/// 合同评审（FR-M03-004 会签：商务/财务/工程/生产四角色；全过→reviewed+自动立项）
model ContractReview {
  id         BigInt    @id @default(autoincrement())
  contractId BigInt
  round      Int       @default(1)
  role       String // biz / fin / eng / mfg
  reviewerId BigInt?
  result     String? // approved / rejected
  opinion    String?   @db.Text
  reviewedAt DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)

  @@index([contractId, round])
  @@map("contract_review")
}

/// 合同变更（FR-M03-007 补充协议 -BCn；改前改后留痕）
model ContractChange {
  id          BigInt    @id @default(autoincrement())
  contractId  BigInt
  changeCode  String    @unique // 主合同号-BC{n}
  content     String    @db.Text // JSON 变更字段 [{field,before,after}]
  reason      String
  status      String    @default("pending") // pending / approved / rejected
  newContractId BigInt? // 通过后生成的补充协议合同
  reviewedBy  BigInt?
  reviewedAt  DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  createdBy   BigInt?
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  updatedBy   BigInt?
  deletedAt   DateTime? @db.Timestamptz(6)

  @@index([contractId])
  @@map("contract_change")
}

/// M02 报价单（05 册未列 T 号，标注新增 Q-10；FR-M02-001~008）
model Quotation {
  id                 BigInt    @id @default(autoincrement())
  quotationCode      String    @unique // QT{YYYY}-{NNNN}
  partyId            BigInt // 客户（下拉 BR-08）
  groupId            BigInt?
  projectId          BigInt? // 可暂"待定"
  productLines       String // JSON E-03
  qty                Int
  unitPriceCents     BigInt // BR-10
  totalCents         BigInt
  validUntil         DateTime? @db.Timestamptz(6)
  ownerId            BigInt // 报价人
  status             String    @default("draft") // draft/sent/won/lost/expired
  expectedSignAt     DateTime? @db.Timestamptz(6) // 中标必填（FR-M02-004）
  convertedContractId BigInt?
  lostReason         String?
  remark             String?
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  createdBy          BigInt?
  updatedBy          BigInt?
  deletedAt          DateTime? @db.Timestamptz(6)

  @@index([partyId])
  @@index([status])
  @@map("quotation")
}

// ============================ 看板域（T-61~T-66 + 会议） ============================

/// T-61 板（九板预置 1 总板 + 4 日板 + 4 周板；可改名不可删 FR-M10-001）
model Board {
  id        BigInt    @id @default(autoincrement())
  boardCode String    @unique // exec① / order② / supply③ / mfg④ / delivery⑤ / rd⑥ / market⑦ / fin⑧ / ga⑨
  name      String
  type      String // executive / daily / weekly
  ownerDept String? // 主责部门 code
  rhythm    String? // 每日 15-30 分钟 / 周一 30 分钟
  status    String    @default("active")
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  createdBy BigInt?
  updatedBy BigInt?
  deletedAt DateTime? @db.Timestamptz(6)

  @@map("board")
}

/// T-62 卡片（五要素；VAGUE 拦截；BR-07 无删除；BR-12 补录标记）
model KbCard {
  id            BigInt    @id @default(autoincrement())
  boardId       BigInt
  title         String
  ownerId       BigInt // 唯一责任人（到人）
  ownerDeptId   BigInt?
  dueDate       DateTime  @db.Timestamptz(6) // 承诺日（可上调不可下调 FR-M10-007）
  status        String    @default("todo") // E-07 todo/doing/blocked/done
  blockedReason String?   @db.Text // 红灯必填
  nextAction    String?   @db.Text // 红灯必填下一步
  isBackfill    Boolean   @default(false) // BR-12
  blockedAt     DateTime? @db.Timestamptz(6) // 红灯起算（3 天升级）
  escalatedAt   DateTime? @db.Timestamptz(6) // 已升级总板
  respondedAt   DateTime? @db.Timestamptz(6) // 责任方响应（48h 扫描）
  sourceType    String? // 一键建卡来源：project/contract/dispatch/work_order/ecn
  sourceId      String?
  crossBoardId  BigInt? // 跨部门挂卡目标板（FR-M10-011）
  crossFlag     String? // out 已外挂 / in 被挂
  closedAt      DateTime? @db.Timestamptz(6)
  remark        String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  createdBy     BigInt?
  updatedBy     BigInt?
  deletedAt     DateTime? @db.Timestamptz(6)

  @@index([boardId, status])
  @@index([ownerId])
  @@index([blockedAt])
  @@map("kb_card")
}

/// T-63 卡片流水（每次变更写；四区拖拽留痕 FR-M10-009）
model KbCardLog {
  id         BigInt   @id @default(autoincrement())
  cardId     BigInt
  fromStatus String?
  toStatus   String
  byId       BigInt?
  note       String?
  isBackfill Boolean  @default(false)
  movedAt    DateTime @default(now()) @db.Timestamptz(6)

  @@index([cardId])
  @@map("kb_card_log")
}

/// T-64 升级记录（board/executive/meeting 三级 E-17；BR-07）
model KbEscalation {
  id          BigInt    @id @default(autoincrement())
  cardId      BigInt
  level       String // board / executive / meeting
  reason      String? // blocked_3d / no_response_48h / manual
  escalatedAt DateTime  @default(now()) @db.Timestamptz(6)
  resolvedAt  DateTime? @db.Timestamptz(6)

  @@index([cardId])
  @@map("kb_escalation")
}

/// T-65 指标定义（formula=参数化 SQL 模板/TS 计算器键；阈值可配 FR-M10-004/005）
model MetricDef {
  id        BigInt    @id @default(autoincrement())
  metricCode String   @unique
  boardCode String
  name      String
  formula   String    @db.Text // metric-sql 包模板键 + SQL（只读）
  unit      String    @default("pct") // pct / wan_cents / count / days
  target    String? // 目标值
  yellowAt  String? // 黄灯阈值
  redAt     String? // 红灯阈值
  direction String    @default("forward") // forward 正向 / reverse 反向
  source    String    @default("auto") // auto / manual（手工每板 ≤1）
  detailKey String? // 下钻明细模板键（FR-M10-006）
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  createdBy BigInt?
  updatedBy BigInt?
  deletedAt DateTime? @db.Timestamptz(6)

  @@index([boardCode])
  @@map("metric_def")
}

/// T-66 指标快照（每日 06:00 全量 + 每 2h 增量；失败置 error 不影响他指标）
model MetricSnapshot {
  id         BigInt   @id @default(autoincrement())
  metricCode String
  period     String // YYYY-MM-DD 或 YYYY-MM
  value      String? // 数值文本（NULL=无数据 → 前端"—"）
  status     String   @default("ok") // ok / error / empty
  computedAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([metricCode, period])
  @@map("metric_snapshot")
}

/// 会议模式记录（FR-M10-018~021：四段议程/三问过堂/自动纪要）
model KbMeeting {
  id          BigInt    @id @default(autoincrement())
  boardId     BigInt
  meetingDate DateTime  @db.Timestamptz(6)
  attendees   String // JSON userIds
  minutes     String?   @db.Text // 纪要 JSON（红灯数/三问结论/今日承诺/上报事项）
  startedAt   DateTime  @default(now()) @db.Timestamptz(6)
  endedAt     DateTime? @db.Timestamptz(6)
  createdBy   BigInt?

  @@index([boardId, meetingDate])
  @@map("kb_meeting")
}

/// 过堂记录（三问：卡在哪/谁解决/何时解决；未填三问不允许下一张 FR-M10-019）
model KbMeetingItem {
  id       BigInt   @id @default(autoincrement())
  meetingId BigInt
  cardId   BigInt
  askWhere String?  @db.Text
  askWho   String?
  askWhen  String?
  skipped  Boolean  @default(false) // 跳过记"未闭环过堂"
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([meetingId, cardId])
  @@map("kb_meeting_item")
}

// ============================ 供应链域（T-15~T-25） ============================

/// T-15 BOM（三类形态 E-19；版本管理；golden 基线）
model Bom {
  id          BigInt    @id @default(autoincrement())
  bomCode     String    @unique // BOM{YYYY}-{NNNN}
  bomType     String    @default("full") // full 完整 / param 参数化 / eng 工程
  productLine String
  name        String
  version     Int       @default(1)
  status      String    @default("draft") // draft / published / void
  parentBomId BigInt? // 两级结构（整机→总成）
  goldenFlag  Boolean   @default(false)
  remark      String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  createdBy   BigInt?
  updatedBy   BigInt?
  deletedAt   DateTime? @db.Timestamptz(6)

  @@index([productLine, status])
  @@map("bom")
}

/// T-16 BOM 行（qty DECIMAL(14,3)；C 类点位 position_code；套件包引用）
model BomLine {
  id           BigInt    @id @default(autoincrement())
  bomId        BigInt
  materialId   BigInt
  qty          Decimal   @db.Decimal(14, 3)
  positionCode String? // C 类：机舱/塔底/塔筒/升压站
  kitRefId     BigInt? // T-19 套件包
  sort         Int       @default(0)
  remark       String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  createdBy    BigInt?
  updatedBy    BigInt?
  deletedAt    DateTime? @db.Timestamptz(6)

  @@index([bomId])
  @@index([materialId])
  @@map("bom_line")
}

/// T-17 ECN 变更单（BR-05：不走 ECN 禁止改 BOM；旧料处置方案必填）
model Ecn {
  id               BigInt    @id @default(autoincrement())
  ecnCode          String    @unique // ECN{YYYY}-{NNNN}
  bomId            BigInt
  fromVersion      Int
  toVersion        Int
  reason           String    @db.Text
  oldMaterialLines String?   @db.Text // JSON 旧料清单
  disposalPlan     String    @db.Text // 旧料处置方案（BR-05 必填）
  status           String    @default("pending") // pending / approved / rejected / published
  approverId       BigInt?
  reviewedAt       DateTime? @db.Timestamptz(6)
  publishedAt      DateTime? @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  createdBy        BigInt?
  updatedAt        DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  updatedBy        BigInt?
  deletedAt        DateTime? @db.Timestamptz(6)

  @@index([bomId])
  @@map("ecn")
}

/// T-21 生产工单（最小闭环：工单-齐套-报工；E-10 状态机）
model WorkOrder {
  id          BigInt    @id @default(autoincrement())
  woCode      String    @unique // WO{YYYY}-{NNNN}
  projectId   BigInt? // BR-03 无项目编码不排产
  contractId  BigInt?
  bomId       BigInt?
  qty         Int
  planStart   DateTime? @db.Timestamptz(6)
  planEnd     DateTime? @db.Timestamptz(6)
  kitStatus   String? // 齐套结果：pass / short（附 kb 红灯联动）
  kitShortLines String? @db.Text // JSON 缺料清单
  status      String    @default("planned") // E-10 planned/kit_checked/started/reported/finished/closed
  remark      String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  createdBy   BigInt?
  updatedBy   BigInt?
  deletedAt   DateTime? @db.Timestamptz(6)

  @@index([projectId])
  @@index([status])
  @@map("work_order")
}

/// T-22 请购单（齐套缺料自动生成/手工；审批后转采购）
model PurchaseReq {
  id        BigInt    @id @default(autoincrement())
  prCode    String    @unique // PR{YYYY}-{NNNN}
  source    String    @default("manual") // kit_short / manual
  projectId BigInt?
  workOrderId BigInt?
  lines     String    @db.Text // JSON [{materialId, qty, note}]
  status    String    @default("pending") // pending / approved / rejected / converted
  approverId BigInt?
  reviewedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  createdBy BigInt?
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  updatedBy BigInt?
  deletedAt DateTime? @db.Timestamptz(6)

  @@map("purchase_req")
}

/// T-23 采购单（E-11 状态机；准交率统计口径）
model PurchaseOrder {
  id           BigInt    @id @default(autoincrement())
  poCode       String    @unique // PO{YYYY}-{NNNN}
  supplierId   BigInt
  projectId    BigInt?
  reqId        BigInt?
  promisedAt   DateTime? @db.Timestamptz(6) // 到货承诺日（准交率基准）
  lines        String    @db.Text // JSON [{materialId, qty, arrivedQty, priceCents}]
  status       String    @default("draft") // E-11 draft/ordered/partial_arrived/arrived/closed
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  createdBy    BigInt?
  updatedAt    DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  updatedBy    BigInt?
  deletedAt    DateTime? @db.Timestamptz(6)

  @@index([supplierId])
  @@index([status])
  @@map("purchase_order")
}

/// T-24 库存（legal_entity 两司隔离；三色标识 E-20；安全库存告警）
model Inventory {
  id            BigInt    @id @default(autoincrement())
  materialId    BigInt
  warehouse     String    @default("YL") // 仓库码
  locationCode  String? // {仓库}-{库区}-{排}-{列}-{层}
  batch         String?
  legalEntity   String    @default("PRT") // E-15 PRT/TLD
  qty           Decimal   @default(0) @db.Decimal(14, 3)
  threeColor    String    @default("blue") // blue/yellow/red
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  createdBy     BigInt?
  updatedBy     BigInt?
  deletedAt     DateTime? @db.Timestamptz(6)

  @@unique([materialId, warehouse, locationCode, batch, legalEntity])
  @@index([materialId])
  @@map("inventory")
}

/// T-25 出入库流水（源头单据驱动；幂等键防重；T+ 推送状态 FR-M06-007）
model StockMove {
  id            BigInt    @id @default(autoincrement())
  moveType      String // in / out
  sourceType    String // arrival(到货入库) / ship(发货) / pick(领料) / adjust(调整) / return(退料)
  sourceId      String
  sourceLine    String?
  materialId    BigInt
  qty           Decimal   @db.Decimal(14, 3)
  projectId     BigInt?
  workOrderId   BigInt?
  legalEntity   String    @default("PRT")
  operatorId    BigInt
  idempotencyKey String   @unique // 单据行+批号（断网重传去重）
  tPlusStatus   String    @default("pending") // pending / pushed / confirmed（FR-M06-007 推送队列）
  tPlusRef      String?
  movedAt       DateTime  @default(now()) @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)

  @@index([materialId])
  @@index([tPlusStatus])
  @@index([movedAt])
  @@map("stock_move")
}

/// 库存每日快照（FR-M06-019：日终快照供对账与趋势）
model InventorySnapshot {
  id         BigInt   @id @default(autoincrement())
  period     String // YYYY-MM-DD
  payload    String   @db.Text // JSON [{materialId, warehouse, legalEntity, qty}]
  totalSkus  Int
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  @@unique([period])
  @@map("inventory_snapshot")
}

// ============================ 交付域（T-41~T-45）与回款域（T-31~T-33） ============================

/// T-41 派工单（PG{YYYY}-{NNNN}；BR-04 风场必填；发货自动生成草稿 FR-M07-002）
model Dispatch {
  id          BigInt    @id @default(autoincrement())
  pgCode      String    @unique
  projectId   BigInt
  windFarmId  BigInt // BR-04：不选风场不许提交
  teamId      BigInt? // 区域组（工程技术部 7 组）
  members     String?   @db.Text // JSON [{userId, role}]
  planDays    Int?
  source      String    @default("manual") // auto_ship / manual
  shipMoveId  BigInt? // 来源发货流水
  status      String    @default("draft") // draft / confirmed / in_progress / done
  taskDesc    String?   @db.Text
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  createdBy   BigInt?
  updatedBy   BigInt?
  deletedAt   DateTime? @db.Timestamptz(6)

  @@index([projectId])
  @@index([status])
  @@map("dispatch")
}

/// T-43 交底记录（方案/安全；⑤板交底及时率口径）
model Disclosure {
  id         BigInt   @id @default(autoincrement())
  projectId  BigInt
  type       String   @default("plan") // plan 方案 / safety 安全
  discloseAt DateTime @db.Timestamptz(6)
  attendees  String? // JSON
  fileId     BigInt?
  content    String?  @db.Text
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  createdBy  BigInt?

  @@index([projectId])
  @@map("disclosure")
}

/// T-44 现场日志（当日 18:00 时限；挂项目与派工单；自动汇总到 BV-03 时间线）
model SiteLog {
  id         BigInt   @id @default(autoincrement())
  projectId  BigInt
  dispatchId BigInt?
  authorId   BigInt
  content    String   @db.Text
  photos     String? // JSON fileId[]
  logDate    DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  @@index([projectId, logDate])
  @@map("site_log")
}

/// T-45 现场问题闭环（责任人/时限/闭环率 ⑤板口径）
model SiteIssue {
  id          BigInt    @id @default(autoincrement())
  projectId   BigInt
  description String    @db.Text
  ownerId     BigInt
  deadline    DateTime  @db.Timestamptz(6)
  closedAt    DateTime? @db.Timestamptz(6)
  status      String    @default("open") // open / closed
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  createdBy   BigInt?

  @@index([projectId, status])
  @@map("site_issue")
}

/// 项目里程碑（FR-M04-004：7 节点模板+自定义；逾期预警）
model Milestone {
  id          BigInt    @id @default(autoincrement())
  projectId   BigInt
  name        String
  sort        Int       @default(0)
  planDate    DateTime? @db.Timestamptz(6)
  actualDate  DateTime? @db.Timestamptz(6)
  status      String    @default("pending") // pending / done / overdue（worker 扫描）
  ownerId     BigInt?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  createdBy   BigInt?
  updatedBy   BigInt?
  deletedAt   DateTime? @db.Timestamptz(6)

  @@index([projectId])
  @@map("milestone")
}

/// T-31 开票（FR-M08-001；BR-02 冻结拦截）
model Invoice {
  id          BigInt    @id @default(autoincrement())
  contractId  BigInt
  projectId   BigInt?
  amountCents BigInt
  invoiceNo   String?
  invoicedAt  DateTime? @db.Timestamptz(6)
  status      String    @default("applied") // applied / issued / void
  applicantId BigInt
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  createdBy   BigInt?

  @@index([contractId])
  @@map("invoice")
}

/// T-33 回款计划（按合同付款条件生成：到货款/验收款/质保金；FR-M08-002）
model PaymentPlan {
  id          BigInt    @id @default(autoincrement())
  contractId  BigInt
  node        String // advance 预付 / delivery 到货款 / acceptance 验收款 / warranty 质保金 / other
  dueAt       DateTime? @db.Timestamptz(6)
  amountCents BigInt
  status      String    @default("pending") // pending / received / overdue
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  createdBy   BigInt?

  @@index([contractId])
  @@map("payment_plan")
}

/// T-32 回款登记（实收核销；双责任人 collector）
model Receipt {
  id          BigInt   @id @default(autoincrement())
  contractId  BigInt
  projectId   BigInt?
  planId      BigInt?
  amountCents BigInt
  receivedAt  DateTime
  method      String? // bank / acceptance / cash
  collectorId BigInt? // 催款责任人（双责任人制）
  remark      String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  createdBy   BigInt?

  @@index([contractId])
  @@map("receipt")
}

/// 验收单（FR-M08-005：验收触发质保期起算）
model Acceptance {
  id             BigInt   @id @default(autoincrement())
  projectId      BigInt
  contractId     BigInt?
  acceptedAt     DateTime
  conclusion     String // pass / conditional / fail
  documents      String? // JSON 资料清单
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  createdBy      BigInt?

  @@index([projectId])
  @@map("acceptance")
}

/// 逾期催收记录（FR-M08-008 ⑧板口径）
model Collection {
  id         BigInt   @id @default(autoincrement())
  contractId BigInt
  method     String   @default("call") // call / letter / visit
  content    String?  @db.Text
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  createdBy  BigInt?

  @@index([contractId])
  @@map("collection")
}

// ============================ 治理域（T-91~T-93 已有别名/词典）与导入 ============================

/// T-91 治理工单（FR-M13-001：BOM 校验/查重/清洗自动生成；分派/处理/复核闭环）
model GovTask {
  id        BigInt    @id @default(autoincrement())
  taskCode  String    @unique // GT{YYYY}-{NNNN}
  type      String // dup_code / name_clean / bom_rule / naming / unmapped_code
  payload   String?   @db.Text // JSON 待处理对象
  assigneeId BigInt?
  result    String?   @db.Text // JSON 处理结果
  status    String    @default("open") // open / processing / done / verified
  sourceType String? // bom_lint / material_dup / unmapped_scan / manual
  sourceId  String?
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  createdBy BigInt?
  updatedBy BigInt?
  deletedAt DateTime? @db.Timestamptz(6)

  @@index([status])
  @@index([type])
  @@map("gov_task")
}

/// 导入批次（FR-M15-008：模板校验/错误行回执/分批导入；全部留审计）
model ImportBatch {
  id           BigInt    @id @default(autoincrement())
  templateKey  String // parties / materials / projects / contracts
  totalRows    Int
  okRows       Int
  errorRows    Int
  errors       String?   @db.Text // JSON [{row, field, message}]
  status       String    @default("done") // done / partial / failed
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  createdBy    BigInt?

  @@map("import_batch")
}

// ============================ AI 域（T-95~T-96）与补货 ============================

/// T-95 AI 调用日志（FR-M16-001/014：谁/何时/输入摘要/token/置信度/可溯源）
model AiCall {
  id           BigInt    @id @default(autoincrement())
  capability   String // AI-01 ~ AI-12
  userId       BigInt?
  inputDigest  String? // 输入摘要（脱敏后）
  model        String    @default("mock")
  tokens       Int?
  latencyMs    Int?
  confidence   String? // DECIMAL 文本
  resultRef    String? // 可溯源引用（原文/草稿 id）
  level        String    @default("ask") // E-18 auto/ask/never
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)

  @@index([capability])
  @@index([userId])
  @@map("ai_call")
}

/// T-96 AI 反馈（字段级采纳/修正闭环）
model AiFeedback {
  id           BigInt   @id @default(autoincrement())
  callId       BigInt
  accepted     Boolean
  editedFields String?  @db.Text // JSON
  reason       String?
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  createdBy    BigInt?

  @@map("ai_feedback")
}

/// 补货申请（FR-M06-013 分级审批 + FR-M06-014 原因结构分析；E-08 原因枚举）
model ReplenishRequest {
  id           BigInt    @id @default(autoincrement())
  projectId    BigInt?
  materialId   BigInt
  qty          Decimal   @db.Decimal(14, 3)
  amountCents  BigInt
  reason       String // E-08
  isSafetyPart Boolean   @default(false) // 安全件先发后签 4h 内出库 24h 补签
  tier         String? // tier1(≤500 一级) / tier2(500-5000) / tier3(>5000 或涉变更)
  status       String    @default("pending") // pending / approved / rejected / shipped / signed_back
  approverId   BigInt?
  reviewedAt   DateTime? @db.Timestamptz(6)
  signedBackAt DateTime? @db.Timestamptz(6)
  remark       String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  createdBy    BigInt?
  updatedAt    DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  updatedBy    BigInt?
  deletedAt    DateTime? @db.Timestamptz(6)

  @@index([status])
  @@index([reason])
  @@map("replenish_request")
}

// ============================ R2 深化：成本域（T-51~T-53）/ 工时 / 盘点 / 呆滞 ============================

/// 工时日报（FR-M04-006：按项目+人员+日期录工时；非项目事项独立字段不入项目统计）
model Worklog {
  id          BigInt   @id @default(autoincrement())
  projectId   BigInt? // 非项目事项（休假/内业/证件）为空
  userId      BigInt
  logDate     DateTime @db.Timestamptz(6)
  hours       Decimal  @db.Decimal(5, 2)
  nonProject  String? // 休假/内业/证件（projectId 为空时必填）
  note        String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  createdBy   BigInt?

  @@index([projectId, logDate])
  @@index([userId, logDate])
  @@map("worklog")
}

/// T-51 成本归集（三口径：labor 工时×费率 / material 物料出库 / expense 费用；rate_snapshot 计费快照）
model CostEntry {
  id           BigInt   @id @default(autoincrement())
  projectId    BigInt
  costType     String // labor / material / expense
  sourceType   String // worklog / stock_move / manual_expense
  sourceId     String?
  amountCents  BigInt
  period       String // YYYY-MM
  rateSnapshot String? // 计费时费率快照（分/人日）
  note         String?
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  createdBy    BigInt?

  @@index([projectId, period])
  @@index([costType])
  @@map("cost_entry")
}

/// T-52 费率表（FR-M09-003：调整留痕只影响后续期间）
model RateCard {
  id            BigInt   @id @default(autoincrement())
  roleKey       String // 角色/岗位键（eng_pm / eng_worker / integration…）
  rateCents     BigInt // 元/人日 → 分
  effectiveFrom DateTime @db.Timestamptz(6)
  remark        String?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  createdBy     BigInt?

  @@index([roleKey, effectiveFrom])
  @@map("rate_card")
}

/// T-53 损益快照（FR-M09-002：收入-成本=毛利；结项锁定 FR-M09-002 locked_at）
model ProjectPnl {
  id            BigInt    @id @default(autoincrement())
  projectId     BigInt    @unique
  revenueCents  BigInt    @default(0)
  costCents     BigInt    @default(0)
  grossMargin   String    @default("0.0000") // DECIMAL(6,4)
  lockedAt      DateTime? @db.Timestamptz(6)
  computedAt    DateTime  @default(now()) @db.Timestamptz(6)

  @@map("project_pnl")
}

/// 盘点任务（FR-M06-009 ABC 循环：A 月盘/B 季盘/C 半盘 + 财务抽盘 20% A 类）
model StocktakeTask {
  id          BigInt    @id @default(autoincrement())
  taskCode    String    @unique // ST{YYYY}{MM}-{NNN}
  cycle       String // A / B / C / sample(财务抽盘)
  scope       String?   @db.Text // JSON 物料范围（ABC 类/仓库）
  status      String    @default("open") // open / counting / closed
  assignedTo  BigInt?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  createdBy   BigInt?
  closedAt    DateTime? @db.Timestamptz(6)

  @@index([status])
  @@map("stocktake_task")
}

/// 盘点行（账面 vs 实盘；差异 → 台账）
model StocktakeLine {
  id           BigInt    @id @default(autoincrement())
  taskId       BigInt
  materialId   BigInt
  warehouse    String    @default("YL")
  legalEntity  String    @default("PRT")
  bookQty      Decimal   @db.Decimal(14, 3)
  countedQty   Decimal?  @db.Decimal(14, 3)
  varianceQty  Decimal?  @db.Decimal(14, 3)
  countedBy    BigInt?
  countedAt    DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  createdBy    BigInt?

  @@index([taskId])
  @@map("stocktake_line")
}

/// 差异台账（FR-M06-010 差异闭环四步：登记→归因(E-09)→调账审批(500 分级)→整改）
model StockVariance {
  id            BigInt    @id @default(autoincrement())
  taskId        BigInt
  lineId        BigInt
  materialId    BigInt
  varianceQty   Decimal   @db.Decimal(14, 3)
  varianceCents BigInt
  cause         String? // E-09 六类归因
  step          String    @default("registered") // registered / attributed / approved / rectified
  approverId    BigInt?
  approvedAt    DateTime? @db.Timestamptz(6)
  rectifyNote   String?   @db.Text
  escalateFlag  Boolean   @default(false) // 同因当月 3 次升级专项
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  createdBy     BigInt?

  @@index([step])
  @@index([materialId])
  @@map("stock_variance")
}

/// 呆滞台账（FR-M06-011/012：90 预警/180 候选；六出路处置矩阵 E-12）
model SlowMoving {
  id             BigInt    @id @default(autoincrement())
  materialId     BigInt
  warehouse      String    @default("YL")
  legalEntity    String    @default("PRT")
  qty            Decimal   @db.Decimal(14, 3)
  lastMoveAt     DateTime? @db.Timestamptz(6)
  level          String // warn(90d) / candidate(180d)
  disposalWay    String? // E-12 六出路
  disposalStatus String    @default("pending") // pending / proposed / approved / done
  ownerId        BigInt? // 责任归属（设计变更→设计等）
  targetAt       DateTime? @db.Timestamptz(6) // 目标消化期
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  updatedBy      BigInt?
  deletedAt      DateTime? @db.Timestamptz(6)

  @@unique([materialId, warehouse, legalEntity])
  @@map("slow_moving")
}

// ============================ R2 深化：售后域（M11）与档案域（T-81/T-82/M12） ============================

/// 售后工单（FR-M11-001：挂项目码；消缺/定检/改造；受阻→红灯联动 FR-M11-007）
model AfterSalesOrder {
  id           BigInt    @id @default(autoincrement())
  orderCode    String    @unique // AS{YYYY}-{NNNN}
  projectId    BigInt
  type         String // fix 消缺 / inspect 定检 / retrofit 改造
  description  String    @db.Text
  ownerId      BigInt
  status       String    @default("open") // open / in_progress / blocked / done
  blockedReason String?  @db.Text
  costCents    BigInt    @default(0) // 质保内成本归集（FR-M11-003 M09 联动）
  startedAt    DateTime? @db.Timestamptz(6)
  doneAt       DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  createdBy    BigInt?
  updatedAt    DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  updatedBy    BigInt?
  deletedAt    DateTime? @db.Timestamptz(6)

  @@index([projectId, status])
  @@map("aftersales_order")
}

/// 定检计划（FR-M11-002：框架协议按周期生成任务）
model MaintenancePlan {
  id          BigInt   @id @default(autoincrement())
  projectId   BigInt
  cycleMonths Int      @default(12)
  nextDueAt   DateTime @db.Timestamptz(6)
  ownerTeam   String?
  lastDoneAt  DateTime? @db.Timestamptz(6)
  status      String   @default("active")
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  createdBy   BigInt?

  @@index([nextDueAt])
  @@map("maintenance_plan")
}

/// T-81 档案（FR-M12-001 档号；FR-M12-002 电子实物互为索引；E-13 八门类/E-14 期限）
model Archive {
  id          BigInt    @id @default(autoincrement())
  archiveNo   String    @unique
  category    String
  retention   String
  title       String
  physicalLoc String?
  fileId      BigInt?
  contractId  BigInt?
  projectId   BigInt?
  status      String    @default("zai_ku") // zai_ku 在库 / borrowed 借出 / destroyed 销毁（存 code）
  dueAt       DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  createdBy   BigInt?
  updatedBy   BigInt?
  deletedAt   DateTime? @db.Timestamptz(6)

  @@index([category])
  @@index([projectId])
  @@map("archive")
}

/// T-82 借阅（FR-M12-003：双审批/证照外带/≤5 工作日逾期催还）
model ArchiveBorrow {
  id         BigInt    @id @default(autoincrement())
  archiveId  BigInt
  borrowerId BigInt
  purpose    String
  needApprove2 Boolean @default(false)
  approver1Id BigInt?
  approver2Id BigInt?
  approvedAt DateTime? @db.Timestamptz(6)
  outAt      DateTime? @db.Timestamptz(6)
  dueAt      DateTime? @db.Timestamptz(6)
  returnedAt DateTime? @db.Timestamptz(6)
  status     String    @default("pending") // pending/approved/rejected/out/returned/overdue
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  createdBy  BigInt?

  @@index([status])
  @@map("archive_borrow")
}

/// 备份管理台账（FR-M12-009 3-2-1）
model BackupRecord {
  id        BigInt   @id @default(autoincrement())
  kind      String
  target    String
  fileRef   String
  sha256    String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  createdBy BigInt?

  @@map("backup_record")
}

// ============================ R2 深化：B/C 类 BOM（T-18/T-19）与点位销项（T-42） ============================

/// T-18 参数模板（B 类：标准节 BOM + 附件包 BOM + 参数 JSON 塔高/塔型/节数）
model ParamTemplate {
  id                    BigInt   @id @default(autoincrement())
  templateCode          String   @unique
  productLine           String
  standardSectionBomId  BigInt
  accessoryPackBomId    BigInt?
  params                String   @db.Text
  createdAt             DateTime @default(now()) @db.Timestamptz(6)
  createdBy             BigInt?

  @@index([productLine])
  @@map("param_template")
}

/// T-19 套件包（C 类：机舱消防套件等）
model KitPack {
  id        BigInt   @id @default(autoincrement())
  kitCode   String   @unique
  name      String
  lines     String   @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(6)
