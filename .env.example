# ProjLife 环境变量样例（复制为 .env 后修改；.env 已被 .gitignore 排除，禁止提交真实密钥）

# 数据库（本地开发示例；生产由部署系统注入）
DB_HOST=localhost
DB_PORT=3306
DB_NAME=projlife
DB_USERNAME=root
DB_PASSWORD=change-me

# Redis（memurai/Redis 6379）
PROJLIFE_REDIS_ENABLED=true

# JWT 密钥（生产必须替换为 64+ 位随机串）
PROJLIFE_JWT_SECRET=dev-only-projlife-jwt-secret-0123456789abcdef0123456789abcdef

# 文件存储根目录
PROJLIFE_STORAGE_ROOT=./data/storage

# AI 网关
PROJLIFE_AI_GATEWAY=http://localhost:8090
# 内网模型端点；留空 = mock 模式（S0 默认）。严禁填写公网 AI 地址（BR-AI-02）
PROJLIFE_AI_MODEL_ENDPOINT=

# 定时任务开关（job 进程）
PROJLIFE_JOB_ENABLED=false
