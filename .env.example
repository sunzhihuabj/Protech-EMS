# ProjLife 环境变量样例（复制为 .env 后修改；.env 已被 .gitignore 排除，禁止提交真实密钥）

# 数据库（本地开发示例；生产由部署系统注入）
DB_HOST=localhost
DB_PORT=3306
DB_NAME=projlife
DB_USERNAME=root
DB_PASSWORD=change-me

# Redis（memurai/Redis 6379）
PROJLIFE_REDIS_ENABLED=true

# JWT 密钥（生产必须替换为 64+ 位随机串）
PROJLIFE_JWT_SECRET=dev-only-projlife-jwt-secret-0123456789abcdef0123456789abcdef

# 文件存储根目录
PROJLIFE_STORAGE_ROOT=./data/storage

# ---- 外部系统接入（SPRINT-INT1：未配置即降级，配置即生效） ----
# 钉钉（D-08 通知主通道：L1 工作通知需三件套；L2 群机器人仅需 webhook+secret）
PROJLIFE_DINGTALK_ENABLED=false
PROJLIFE_DINGTALK_APP_KEY=
PROJLIFE_DINGTALK_APP_SECRET=
PROJLIFE_DINGTALK_AGENT_ID=
PROJLIFE_DINGTALK_WEBHOOK=
PROJLIFE_DINGTALK_WEBHOOK_SECRET=
# 测试期静态映射 "sys_userId:钉钉userid"（生产批次上通讯录同步）
PROJLIFE_DINGTALK_USER_MAPPING=

# 售后宝（事件/工单同步；需固定公网 IP 白名单；Webhook 推送需企业版+）
PROJLIFE_SHB_ENABLED=false
PROJLIFE_SHB_APP_KEY=
PROJLIFE_SHB_APP_SECRET=
PROJLIFE_SHB_BASE_URL=https://oapi.shb.ltd
PROJLIFE_SHB_WEBHOOK_KEY=

# 捷信通T+ 13.0（通道B直连：存货/基础档案；三件套由畅捷通发放）
PROJLIFE_TPLUS_ENABLED=false
PROJLIFE_TPLUS_BASE_URL=https://hbtgl.a4.cjtmsp.com
PROJLIFE_TPLUS_APP_KEY=
PROJLIFE_TPLUS_APP_SECRET=
PROJLIFE_TPLUS_ORG_ID=
PROJLIFE_TPLUS_TOKEN_MODE=REALNAME
PROJLIFE_TPLUS_USER_NAME=
PROJLIFE_TPLUS_PASSWORD=
PROJLIFE_TPLUS_ACC_NUM=
# ISV 私钥（PKCS#8 Base64 或 PEM 全文）
PROJLIFE_TPLUS_PRIVATE_KEY=

# AI 网关
PROJLIFE_AI_GATEWAY=http://localhost:8090
# 模型端点（OpenAI 兼容 chat/completions 全 URL）；留空 = mock 模式（S0 默认）
PROJLIFE_AI_MODEL_ENDPOINT=
# 模型访问密钥（Bearer）；与端点、模型名三者齐备即启用真实推理
PROJLIFE_AI_API_KEY=
# 推理模型名（如 deepseek-ai/deepseek-v4.1-flash / z-ai/glm-5.3-flash）
PROJLIFE_AI_MODEL_NAME=

# 定时任务开关（job 进程）
PROJLIFE_JOB_ENABLED=false
